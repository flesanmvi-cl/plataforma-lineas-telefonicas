# ============================================================
# Líneas Telefónicas — variables de entorno
# Copiar a .env (producción/docker) y/o .env.local (dev en tu máquina) y
# completar. `npm run dev`/`npm run start` cargan .env y .env.local solos
# (ver el script "dotenv -c" en package.json) — no hace falta exportar nada
# a mano ni pasar -p. NO commitear .env ni .env.local (ver .gitignore).
# Credenciales: en la VM salen de connections.env (CONN_*), nunca de git.
# ============================================================

# ── Puerto ───────────────────────────────────────────────────────────────────
# Único lugar donde se define: lo leen npm run dev/start (vía dotenv-cli) Y
# docker-compose.yml (${PORT:-3000}, sin rebuild). Cambia solo este valor.
PORT=3000

# ── Login estándar CIA (Auth.js v5 + Google Workspace) ─────────────────────
# Client ID/Secret únicos de CIA — mismo valor en todas las plataformas Auth.js
# (coordinar con el equipo CIA, ver servicios-compartidos/login-estandar/config/google-oauth.md)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Propio de esta app, NO se comparte entre plataformas: openssl rand -hex 32
AUTH_SECRET=
# P2 (docs/PLAN.md): sumar flesan.com.pe si los usuarios de Perú entran en esta etapa.
CIA_ALLOWED_DOMAINS=flesan.cl
# Llave maestra de administración: estos correos son "admin" aunque la base falle.
CIA_ADMIN_EMAILS=

# URL pública fija de esta plataforma. En producción debe coincidir EXACTO con el
# redirect URI registrado en Google Cloud Console (<AUTH_URL>/api/auth/callback/google).
# También la usa la verificación de origen de las APIs (lib/auth-guard.ts).
# AUTH_URL=https://lineastelefonicas.flesanmvi.com

# Bypass de login SOLO para desarrollo (ignorado si NODE_ENV=production, ver
# auth.ts/middleware.ts): sesión falsa de dev@flesan.cl, que existe en la base de
# desarrollo. NUNCA lo dejes en "true" en el .env de un despliegue real.
# AUTH_DISABLED=true
# DEV_ROLE=admin

# ── Widget de feedback CIA ──────────────────────────────────────────────────
CIA_FEEDBACK_URL=http://192.168.10.22:8083
# Coordinar con el equipo CIA para registrar "plataforma_lineas_telefonicas:<token>"
# en CIA_SERVICE_TOKENS del feedback-api central.
CIA_SERVICE_TOKEN=

# ── Base transaccional de Chile: flesan (SOLO LECTURA) ───────────────────────
# Maestros de empresas, unidades de negocio, centros de costo y colaboradores
# (docs/MIGRACION.md §9). lib/db.ts abre la sesión en modo solo lectura.
DATABASE_URL=

# ── Base de la plataforma: srvpd_bd (lectura y escritura) ────────────────────
# Esquemas s_lineas y seguridadapp, compartidos con el aplicativo antiguo
# mientras convivan (docs/PLAN.md, P0). Para desarrollar, NUNCA la real: la base
# local de `npm run db:dev`:
#   DATABASE_URL_PLATAFORMA=postgresql://postgres:postgres@localhost:54329/lineas_dev
DATABASE_URL_PLATAFORMA=
# Nombres de esquema (por defecto, los reales; la base de desarrollo usa los mismos).
# ESQUEMA_LINEAS=s_lineas
# ESQUEMA_SEGURIDAD=seguridadapp

# Sin esquema cia_<slug> (docs/PLAN.md, P0): vacío. Mi personalización queda en el
# navegador y no hay avisos, como prevé el shell.
ESQUEMA_PLATAFORMA=
