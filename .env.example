# ============================================================
# Copiar a .env (producción/docker) y/o .env.local (dev en tu máquina) y
# completar. `npm run dev`/`npm run start` cargan .env y .env.local solos
# (ver el script "dotenv -c" en package.json) — no hace falta exportar nada
# a mano ni pasar -p. NO commitear .env ni .env.local (ver .gitignore).
# ============================================================

# ── Puerto ───────────────────────────────────────────────────────────────────
# Único lugar donde se define: lo leen npm run dev/start (vía dotenv-cli) Y
# docker-compose.yml (${PORT:-3000}, sin rebuild). Cambia solo este valor.
PORT=3000

# ── Login estándar CIA (Auth.js v5 + Google Workspace) ─────────────────────
# Client ID/Secret únicos de CIA — mismo valor en todas las plataformas Auth.js
# (coordinar con el equipo CIA, ver servicios-compartidos/login-estandar/config/google-oauth.md)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Propio de esta app, NO se comparte entre plataformas: openssl rand -hex 32
AUTH_SECRET=
CIA_ALLOWED_DOMAINS=flesan.cl
# Emails con rol "admin" (el resto de la organización queda como "member")
CIA_ADMIN_EMAILS=

# URL pública fija de esta plataforma (opcional en dev — Auth.js la infiere de
# la request). Necesaria en producción si hay reverse proxy/dominio propio:
# debe coincidir EXACTO con el redirect URI registrado en Google Cloud Console
# (<AUTH_URL>/api/auth/callback/google).
# AUTH_URL=https://nombre-plataforma.grupoflesan.com

# Bypass de login SOLO para desarrollo/pruebas en VM local (ignorado si
# NODE_ENV=production, ver auth.ts/middleware.ts). Con AUTH_DISABLED=true no hace
# falta pasar por Google: la app usa una sesión falsa para poder navegar todo el
# dashboard, incluidas las secciones adminOnly. NUNCA lo dejes en "true" en el
# .env de un despliegue real.
# AUTH_DISABLED=true
# DEV_ROLE=admin

# ── Widget de feedback CIA ──────────────────────────────────────────────────
CIA_FEEDBACK_URL=http://192.168.10.22:8083
# Coordinar con el equipo CIA para registrar "<slug>:<token>" en CIA_SERVICE_TOKENS
# del feedback-api central. El slug debe coincidir con data-plataforma en app/layout.tsx.
CIA_SERVICE_TOKEN=

# ── Trazabilidad de uso en el Portal CIA (opcional) ─────────────────────────
# Reporta al portal quién usa esta plataforma aunque entre por el link directo.
# Sin código propio en esta base todavía — descomenta y agrega el beacon
# (ver lib/portal-track.ts en otras plataformas CIA) solo si el Portal lo pide.
# PORTAL_TRACK_URL=https://portal-cia.grupoflesan.com/api/track
# PORTAL_TRACK_KEY=

# ── Base de datos (opcional) ────────────────────────────────────────────────
# lib/db.ts ya trae el pool de Postgres (pg) listo para usar — solo descomenta esta
# variable si la plataforma necesita Postgres (ver docs/ARQUITECTURA.md). Sin
# DATABASE_URL, lib/db.ts queda inerte (nunca conecta) y auth.ts resuelve el rol
# solo por CIA_ADMIN_EMAILS.
# DATABASE_URL=postgresql://usuario:password@host:5432/basededatos

# ── Email saliente por SMTP (opcional) ──────────────────────────────────────
# lib/mailer.ts ya trae sendEmail() listo (nodemailer) — solo descomenta y
# completa estas variables si la plataforma necesita mandar correo. Sin
# SMTP_HOST/USER/PASSWORD, sendEmail() no falla: loguea a consola y sigue.
# Probado con Gmail + App Password (https://myaccount.google.com/apppasswords).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=equipo_desarrollo@flesan.cl
# SMTP_PASSWORD=
# SMTP_FROM_NAME=Nombre Plataforma · Grupo Flesan
